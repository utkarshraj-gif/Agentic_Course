# Leave OPENAI_API_KEY empty to run the whole course offline (deterministic heuristics).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible server: vLLM (http://localhost:8000/v1), Azure OpenAI, NVIDIA NIM
LLM_BASE_URL=
EMBED_MODEL=text-embedding-3-small
# Force offline mode even when a key is present
OFFLINE=0

# Class 6 - long-term memory
REDIS_URL=
# Class 7 / 11 - tracing & evals
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai-course
OPIK_API_KEY=
