# ==============================================================================
# VELLOE LEARNS: ENTERPRISE AGENTIC AI COURSE ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- MODEL & INFERENCE PROVIDERS ---
# Leave OPENAI_API_KEY empty to run the entire 15-class curriculum in offline deterministic mock mode.
OPENAI_API_KEY=

# Default reasoning model
LLM_MODEL=gpt-4o-mini

# Custom OpenAI-compatible endpoint (optional)
# Point at local vLLM (http://localhost:8000/v1), Ollama (http://localhost:11434/v1), Azure OpenAI, or NVIDIA NIM
LLM_BASE_URL=

# Default vector embedding model
EMBED_MODEL=text-embedding-3-small

# Set to 1 to force offline deterministic mock mode even if OPENAI_API_KEY is populated
OFFLINE=0

# --- PERSISTENT STATE & MEMORY (Class 6 & Capstones) ---
# Local Redis connection URI for LangGraph state checkpointing and durable memory
REDIS_URL=redis://localhost:6379/0

# --- OBSERVABILITY & EVALUATIONS (Class 7 & 11) ---
# Optional LangSmith tracing & evaluation configuration
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai-course

# Optional Comet Opik tracing configuration
OPIK_API_KEY=

# --- CLOUD DATABASE (Progress & Admin Course Persistence) ---
# Neon Serverless PostgreSQL connection string
DATABASE_URL=
NEON_DATABASE_URL=
